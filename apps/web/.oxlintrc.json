{
  // First-stage migration: keep Biome's existing correctness/Solid enforcement
  // until the rule and suppression mapping is complete. New JS-plugin findings
  // are advisory; enabling the entire Oxlint preset adds thousands of findings.
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["promise"],
  "jsPlugins": ["eslint-plugin-solid", "eslint-plugin-unused-imports"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "promise/prefer-await-to-then": "warn",
    "complexity": "warn",
    "solid/jsx-uses-vars": "warn",
    "solid/reactivity": "warn",
    "solid/no-destructure": "warn",
    "solid/prefer-for": "warn",
    "unused-imports/no-unused-imports": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/*.gen.ts",
    "**/patches/**",
    "scripts/**",
    "src/lib/filesystem/**"
  ]
}
